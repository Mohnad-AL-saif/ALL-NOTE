NetExec Multi-Protocol Check
for ip in <IP>; do
  for mod in smb winrm wmi rdp mssql ldap; do
    nxc $mod $ip -u <user> -p <password>
  done
  for mod in ssh ftp nfs vnc; do
    nxc $mod $ip -u <user> -p <password>
  done
done

